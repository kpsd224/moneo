{
  "cli": {
    "version": ">= 15.0.0"
  },
  "build": {
    "android-apk": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "ios-iphone": {
      "distribution": "internal",
      "ios": {
        "simulator": false
      }
    },
    "ios-testflight": {
      "distribution": "store",
      "ios": {
        "simulator": false
      }
    },
    "ios-simulator": {
      "ios": {
        "simulator": true
      }
    },
    "production": {
      "autoIncrement": true
    }
  }
}
