{
  "expo": {
    "name": "Moneo",
    "slug": "moneo",
    "scheme": "moneo",
    "version": "1.1.15",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F7F5EF",
    "android": {
      "package": "com.anabudget.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "versionCode": 15
    },
    "ios": {
      "bundleIdentifier": "com.anabudget.app",
      "supportsTablet": true,
      "infoPlist": {
        "NSHumanReadableCopyright": "© 2026 Na"
      },
      "buildNumber": "15"
    },
    "web": {
      "name": "Moneo"
    },
    "experiments": {
      "tsconfigPaths": true
    },
    "icon": "./assets/icon.png",
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7F5EF",
          "image": "./assets/splash-icon.png",
          "imageWidth": 220
        }
      ],
      [
        "expo-widgets",
        {
          "bundleIdentifier": "com.anabudget.app.widgets",
          "groupIdentifier": "group.com.anabudget.app",
          "enableAndroid": true,
          "widgets": [
            {
              "name": "AnaFinanceWidget",
              "displayName": "Moneo: Saldo & Maskot",
              "description": "Saldo, pemasukan, pengeluaran, maskot transparan dan status keuangan.",
              "ios": {
                "supportedFamilies": [
                  "systemMedium",
                  "systemLarge"
                ],
                "contentMarginsDisabled": true
              },
              "android": {
                "targetCellWidth": 5,
                "targetCellHeight": 2,
                "minWidth": 300,
                "resizeMode": "horizontal"
              }
            }
          ]
        }
      ]
    ],
    "description": "Moneo — keuangan pribadi offline dengan widget maskot. © 2026 Na."
  }
}
