{
  "expo": {
    "name": "Moneo",
    "slug": "moneo",
    "scheme": "moneo",
    "version": "1.1.19",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F7F5EF",
    "android": {
      "package": "com.anabudget.app",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "versionCode": 19
    },
    "ios": {
      "bundleIdentifier": "com.anabudget.app",
      "supportsTablet": true,
      "infoPlist": {
        "NSHumanReadableCopyright": "© 2026 Na"
      },
      "buildNumber": "19"
    },
    "web": {
      "name": "Moneo"
    },
    "experiments": {
      "tsconfigPaths": true
    },
    "icon": "./assets/icon.png",
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7F5EF",
          "image": "./assets/splash-icon.png",
          "imageWidth": 220
        }
      ],
      [
        "expo-asset",
        {
          "assets": [
            "./assets/widget/happy.png",
            "./assets/widget/thoughtful.png",
            "./assets/widget/worried.png",
            "./assets/widget/panic.png",
            "./assets/widget/bunny_happy.png",
            "./assets/widget/bunny_thoughtful.png",
            "./assets/widget/bunny_worried.png",
            "./assets/widget/bunny_panic.png",
            "./assets/widget/sehun_happy.png",
            "./assets/widget/sehun_thoughtful.png",
            "./assets/widget/sehun_worried.png",
            "./assets/widget/sehun_panic.png",
            "./assets/widget/moneo_logo.png"
          ]
        }
      ],
      [
        "expo-widgets",
        {
          "bundleIdentifier": "com.anabudget.app.widgets",
          "groupIdentifier": "group.com.anabudget.app",
          "enableAndroid": true,
          "widgets": [
            {
              "name": "AnaFinanceWidget",
              "displayName": "Moneo: Saldo & Maskot",
              "description": "Saldo, uang masuk, uang keluar, dan maskot Moneo.",
              "ios": {
                "supportedFamilies": [
                  "systemMedium",
                  "systemLarge"
                ],
                "contentMarginsDisabled": true
              },
              "android": {
                "targetCellWidth": 5,
                "targetCellHeight": 2,
                "minWidth": 320,
                "minHeight": 110,
                "resizeMode": "none"
              }
            }
          ]
        }
      ]
    ],
    "description": "Moneo — keuangan pribadi offline dengan widget maskot. © 2026 Na."
  }
}
